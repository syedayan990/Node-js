<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home Details</title>
  <link rel="stylesheet" href="/output.css">
</head>

<body class="bg-wihite">

 <nav class="bg-red-500 text-white shadow-md">
  <div class="max-w-6xl mx-auto flex gap-8 px-6 py-3">
    <a href="/" class="px-3 py-2 rounded hover:bg-red-200">Home</a>
    <a href="/homes" class="px-3 py-2 rounded hover:bg-red-200">Homes-List</a>
    <a href="/favourite" class="px-3 py-2 rounded hover:bg-red-200">Favourites</a>
    <a href="/booking" class="px-3 py-2 rounded hover:bg-red-200">Booking</a>
    <a href="/host/host-home-list" class="px-3 py-2 rounded hover:bg-red-200">Host-Home-List</a>
    <a href="/host/add-home" class="px-3 py-2 rounded hover:bg-red-200">Add Home</a>
    <a href="/Login" class="px-3 py-2 rounded hover:bg-red-200">Logout</a>
  </div>
</nav>

  <main class="flex justify-center mt-12">
    <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-md">
      <img src="<%= home.PhotoUrl %>" alt="<%= home.houseName %>" class="w-full h-96 object-cover">
      <h1 class="text-3xl font-bold text-gray-800 mb-2"><%= home.houseName %></h1>
      <p class="text-gray-600 mb-1">Location: <%= home.Location %></p>
      <p class="text-gray-600 mb-1">★ <%= home.Rating %></p>
      <p class="text-red-600 font-bold text-xl">₹<%= home.Price %> / night</p>
       <%- include('../partials/favourite', { home: home }) %>
    </div>
    
  </main>
  
</body>
</html>